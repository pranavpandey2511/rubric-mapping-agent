# Copy to .env and provide an OpenAI API key.
OPENAI_API_KEY=

# Optional LangSmith tracing. Leave disabled when no LangSmith account is used.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rubric-mapping-agent

# Default only; override this while running model/cost experiments.
OPENAI_MODEL=openai:gpt-5.6-terra

# Hosted Code Interpreter container memory: 1g, 4g, 16g, or 64g.
OPENAI_CODE_INTERPRETER_MEMORY=4g

# Per-stage execution scope: sheet or workbook. These defaults preserve the
# current pipeline behavior. Sheet-scoped invocations run concurrently and are
# combined deterministically in workbook order.
RUBRIC_MAP_PART1_SCOPE=sheet
RUBRIC_MAP_PART2_SCOPE=workbook
RUBRIC_MAP_PART3_SCOPE=workbook
RUBRIC_MAP_SHEET_MAX_WORKERS=4

# Part 3 retrieval context: none, part1, or part1_part2.
RUBRIC_MAP_PART3_CONTEXT=part1_part2

# Cross-stage handoff channels. JSON controls Part 1 sections plus both Part 2
# JSON artifacts. Summary controls only the Part 1 Markdown summary because
# Part 2 now produces an agent-authored JSON index instead of Markdown.
# Part 2 requires at least one Part 1 channel. Part 3 may run with both disabled.
RUBRIC_MAP_HANDOFF_JSON=true
RUBRIC_MAP_HANDOFF_SUMMARY=true

# Optional read-only visual tool: off, libreoffice_pdf, or libreoffice_ui.
RUBRIC_MAP_VISUAL_BACKEND=off
# Stable screenshot viewport. The UI backend resizes the Calc window; the PDF
# backend rasterizes the selected range to this width.
RUBRIC_MAP_VISUAL_WIDTH=1440
RUBRIC_MAP_VISUAL_HEIGHT=900
# Process startup/render timeout and UI settle delay, in seconds.
RUBRIC_MAP_VISUAL_TIMEOUT_SECONDS=45
RUBRIC_MAP_VISUAL_CAPTURE_DELAY_SECONDS=0.6
# Optional executable overrides for nonstandard installations.
RUBRIC_MAP_LIBREOFFICE_BIN=
RUBRIC_MAP_LIBREOFFICE_PYTHON=
RUBRIC_MAP_PDF_RASTERIZER=
RUBRIC_MAP_LIBREOFFICE_PROCESS_NAME=LibreOffice
